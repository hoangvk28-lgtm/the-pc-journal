# Site identity and launch gate
NEXT_PUBLIC_SITE_URL=https://www.thepcjournal.com
SITE_LAUNCHED=false

# Configure these only for this publication after creating its accounts.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional admin: set all three before using /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional dedicated Supabase project. Do not reuse the Office Journal database.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Amazon Creators API. Use this site's confirmed Associates tag.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=